{
  "name": "mynda",
  "version": "1.0.0",
  "description": "A media library and player app",
  "main": "src/bootstrap.js",
  "scripts": {
    "test": "npm run test:fast",
    "test:fast": "node test/run-tests.js fast",
    "test:core": "node test/run-tests.js core",
    "test:list": "node test/run-tests.js list",
    "test:unit": "node test/run-tests.js unit",
    "test:integration": "node test/run-tests.js integration",
    "test:component": "node test/run-tests.js component",
    "test:renderer": "npm run test:component",
    "test:electron": "node test/run-tests.js e2e",
    "test:e2e": "npm run test:electron",
    "test:all": "node test/run-tests.js all",
    "library:migrate": "node scripts/migrate-video-ids.js",
    "media:prepare": "node scripts/prepare-media-tools.js",
    "media:prepare:macos": "bash scripts/prepare-media-tools-macos.sh",
    "media:prepare:windows": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-media-tools-windows.ps1",
    "media:prepare:linux": "bash scripts/prepare-media-tools-linux.sh",
    "media:status": "node scripts/media-tools-status.js",
    "media:verify": "node scripts/verify-media-tools.js",
    "test:media": "npm run media:verify && node test/MediaDependencies.integration.test.js --require-bundled",
    "test:package": "npm run test:fast && npm run media:verify && electron-builder --dir --publish never && node test/package/run-packaged-media-smoke.js",
    "start": "electron .",
    "dist": "npm run media:verify && electron-builder",
    "test:paths": "node test/SourceLayout.integration.test.js",
    "source:cleanup": "node scripts/finish-source-reorganization.js",
    "test:electron:asar": "node test/electron/run-electron-smoke.js --asar"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@babel/cli": "^7.12.1",
    "@babel/core": "^7.12.3",
    "@babel/preset-react": "^7.12.1",
    "@babel/register": "^7.12.1",
    "@jsep-plugin/arrow": "^1.0.6",
    "@jsep-plugin/comment": "^1.0.4",
    "@jsep-plugin/numbers": "^1.0.2",
    "@jsep-plugin/object": "^1.2.2",
    "@jsep-plugin/spread": "^1.0.3",
    "@jsep-plugin/template": "^1.0.5",
    "@jsep-plugin/ternary": "^1.1.4",
    "axios": "^0.21.1",
    "check-disk-space": "^3.0.1",
    "datejs": "^1.0.0-rc3",
    "fluent-ffmpeg": "^2.1.2",
    "fs-hard-drive": "^1.0.0",
    "jsep": "^1.4.0",
    "lodash": "^4.17.20",
    "node-mpv": "^2.0.0-beta.2",
    "object-hash": "^2.0.3",
    "react": "^16.13.1",
    "react-beautiful-dnd": "^13.0.0",
    "react-dom": "^16.13.1",
    "react-virtuoso": "4.18.12",
    "request": "^2.88.2",
    "subtitle": "^4.1.0",
    "uuid": "^8.3.0"
  },
  "devDependencies": {
    "electron": "12.0.5",
    "electron-builder": "^22.7.0"
  },
  "build": {
    "appId": "com.torvor.mynda",
    "beforeBuild": "./scripts/verify-media-tools.js",
    "extraResources": [
      {
        "from": "vendor/media-tools/${os}-${arch}",
        "to": "media-tools",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "**/*",
      "!sandbox{,/**/*}",
      "!devtools/**/*",
      "!scripts/**/*",
      "!test/**/*",
      "!vendor/**/*",
      "!TESTING.md",
      "!MEDIA_TOOLS.md",
      "!MIGRATING_VIDEO_IDS.md",
      "!src/legacy{,/**/*}",
      "!themes{,/**/*}",
      "!SOURCE_LAYOUT.md"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    }
  }
}
